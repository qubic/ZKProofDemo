# =====================================================================================
#  ZKProofDemo — THE ONE deployment config. Every script, the guest build and the
#  contract deploy read this file. Edit here only. `scripts/check_config.sh` validates it.
# =====================================================================================

# devnet | mainnet.  mainnet adds confirmation prompts + extra checks in every script.
ZKQ_PROFILE=devnet

# ---- Qubic side -----------------------------------------------------------------------
# Arbitrator IDENTITY (60 upper-case chars). The guest derives the 32-byte pubkey from it and
# BAKES IT INTO THE IMAGE_ID: change it => rebuild => new IMAGE_ID => setImageId on-chain.
#   devnet : ZSDAHLHNHVWTEDYXRTTDWNKGRVPAFQKNTOUXPOXSCDGOPTMUJFWPVATFXHPG  (seed 'z'*55, gen_fixture signs)
#   mainnet: AFZPUAIYVPNUYGJRQVLUKOPPVLHAZQTGLYAAUUNBXFTVTAMSBKQBLEIEPCVJ  (core public_settings.h ARBITRATOR;
#            the BroadcastComputors packet must then come from the live network, gen_fixture cannot sign it)
ZKQ_ARBITRATOR_IDENTITY=ZSDAHLHNHVWTEDYXRTTDWNKGRVPAFQKNTOUXPOXSCDGOPTMUJFWPVATFXHPG

# ---- Ethereum side --------------------------------------------------------------------
# chain id must match ETH_RPC (checked). Router = RiscZeroVerifierRouter for that chain
# (risc0-ethereum deployment.toml): sepolia 0x925d8331ddc0a1F0d96E68CF073DFE1d92b69187,
#                                   mainnet 0x8EaB2D97Dfce405A1692a21b3ff3A172d593D319
ETH_CHAIN_ID=11155111
ETH_RPC=https://gateway.tenderly.co/public/sepolia
RISC0_ROUTER=0x925d8331ddc0a1F0d96E68CF073DFE1d92b69187

# QubicQuorumVerifier address. EMPTY => scripts/deploy_verifier.sh deploys and writes it here.
# Set => deploy_verifier.sh only syncs: proposeImageId(built IMAGE_ID) unless already active/pending.
VERIFIER=0xcc187859d82eae77bf82ac8e98c17dd2885b26f2
# Contract owner (may proposeImageId/revokeImageId). EMPTY => the deployer key below.
OWNER=
# Seconds between proposeImageId and the image being accepted (constructor immutable).
# devnet 0; mainnet >= 86400 recommended (check_config WARNs below that).
ROTATION_DELAY=0
# Signer (deployer / owner). Preferred: a Foundry keystore name (`cast wallet import <name> --interactive`);
# password is prompted (or ETH_PASSWORD_FILE, mode 0600). Fallback: WALLET_FILE with a line
# PRIVATE_KEY=0x... (mode 0600, relative to the repo root, gitignored). Use ETH_ACCOUNT on mainnet.
ETH_ACCOUNT=
ETH_PASSWORD_FILE=
WALLET_FILE=.wallet

# ---- Prover farm (bento) --------------------------------------------------------------
# Box running postgres/redis/minio + rest_api + aux/exec/join/snark agents (scripts/bento/start_server.sh).
BENTO_INFRA_HOST=127.0.0.1
# Client side (zkq-prove): rest_api of that box. Key is ignored by bento but must be non-empty.
BONSAI_API_URL=http://127.0.0.1:8081
BONSAI_API_KEY=anything
# bento binaries — MUST embed the same risc0-zkvm as Cargo.lock (3.0.4); status.sh checks.
BENTO_AGENT=/opt/bento/agent
BENTO_REST_API=/opt/bento/rest_api
# exec agent segment size: 20 = 1M cycles (fits 16 GB GPUs); 21 halves join work, needs ~12 GB free.
SEGMENT_PO2=20
# infra credentials. Dev defaults are REFUSED unless BENTO_INFRA_HOST is 127.0.0.1; ports 5432/6379/
# 9000/8081 are unauthenticated beyond these creds: firewall them to the GPU LAN.
BENTO_PG_USER=worker
BENTO_PG_PASSWORD=password
BENTO_PG_DB=taskdb
BENTO_MINIO_USER=admin
BENTO_MINIO_PASSWORD=password
BENTO_LOG_DIR=/tmp/bento
