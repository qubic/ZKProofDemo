# Copy to docker/bento.env and pass with `docker compose --env-file docker/bento.env ...`
# (or export in the shell). All values have the same defaults inside docker-compose.yml.

# --- images ---------------------------------------------------------------
# Official boundless bento images (boundless/dockerfiles/DOCKER_IMAGES.md). BENTO_TAG must ship
# risc0-zkvm 3.0.4 (same as the client pin) — check `agent --version` / image labels; "latest" is
# an unpinned nightly. The path proven on the authors' farm is the native bento-cluster agents built from
# boundless/bento at risc0 3.0.4.
BENTO_TAG=PIN_ME
#AGENT_IMAGE=ghcr.io/boundless-xyz/boundless/bento-agent:PIN_ME
#CPU_AGENT_IMAGE=ghcr.io/boundless-xyz/boundless/bento-agent-cpu:PIN_ME
#REST_API_IMAGE=ghcr.io/boundless-xyz/boundless/bento-rest-api:PIN_ME
DOCKER_RUNTIME=nvidia

# --- infra credentials (dev defaults; change if ports are reachable from untrusted hosts) --
POSTGRES_USER=worker
POSTGRES_PASSWORD=password
POSTGRES_DB=taskdb
MINIO_ROOT_USER=admin
MINIO_ROOT_PASS=password
MINIO_BUCKET=workflow

# --- prover tuning ----------------------------------------------------------
SEGMENT_SIZE=21          # segment po2 for exec (21 = 2M cycles/segment; lower if a GPU runs out of VRAM)
SNARK_TIMEOUT=3600       # seconds rest_api waits for the groth16 wrap
REDIS_TTL=57600
RUST_LOG=info

# --- multi-box workers (docker-compose.worker.yml only) ----------------------
#BENTO_INFRA_HOST=192.168.1.10

# --- client side (the host prover, e.g. inside the dev container) -------------
# The risc0 SDK routes proving to bento when these are set. Bento ignores the key.
BONSAI_API_URL=http://rest_api:8081     # from outside compose: http://<host>:8081
BONSAI_API_KEY=anything
RISC0_DEV_MODE=0                        # 1 = fake receipts, no proving (fast path)
